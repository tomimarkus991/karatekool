# Site (Next.js)
# The Spring API, see api/
NEXT_PUBLIC_API_URL="http://localhost:8080/api/v1"
# Google web client ID for the sign-in button. Leave empty in development for the dev sign-in button
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

ANALYZE=false

# API (Spring Boot, production only: the dev profile needs none of these)
JWT_SECRET=""
GOOGLE_CLIENT_IDS=""
CORS_ALLOWED_ORIGINS="https://karatekool.ee"
RESEND_API_KEY=""
# Read by docker-compose.prod.yml
DOCKERHUB_USERNAME=""
POSTGRES_USER="karatekool"
POSTGRES_PASSWORD=""
POSTGRES_DB="karatekool"
