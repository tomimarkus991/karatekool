{
  "sources": [
    {
      "name": "web",
      "title": "Next.js web app",
      "lang": "ts",
      "root": "src",
      "depth": 2,
      "exclude": [
        "**/*.test.ts",
        "**/*.test.tsx"
      ],
      "tsconfig": "tsconfig.json",
      "depth_overrides": {
        "components/elements": 3
      }
    }
  ],
  "output": "docs/c4",
  "migrations": null,
  "levels": {
    "level-1": [
      "package.json",
      "README.md",
      ".env.example",
      "next.config.js"
    ],
    "level-2": [
      "package.json",
      "next.config.js",
      ".env.example",
      ".github/workflows",
      "src/lib",
      "src/app/api",
      "src/app/layout.tsx",
      "src/context/SupabaseContext.tsx"
    ],
    "level-3": [
      "src"
    ],
    "database": [
      "src/types/supabase.ts"
    ]
  },
  "human_docs": "docs/architecture",
  "components": {
    "web/(root)": {
      "label": "Module declarations",
      "tech": "TypeScript",
      "desc": "Ambient asset module type declarations"
    },
    "web/app": {
      "label": "Root layout and home",
      "tech": "Next.js App Router, React Query",
      "desc": "Root layout, session bootstrap, sitemap, robots"
    },
    "web/app-constants": {
      "label": "Form schemas",
      "tech": "Yup",
      "desc": "Form values, validation schemas, constants"
    },
    "web/app/(children)": {
      "label": "Site pages",
      "tech": "Next.js App Router, Headless UI",
      "desc": "Public, member and auth pages (Estonian routes)"
    },
    "web/app/(home_components)": {
      "label": "Home page sections",
      "tech": "Next.js",
      "desc": "Landing page sections and hero images"
    },
    "web/app/api": {
      "label": "API route handlers",
      "tech": "Next.js Route Handlers, Resend, Upstash",
      "desc": "Rate-limited sign-up and question emails"
    },
    "web/components": {
      "label": "Component barrel",
      "tech": "TypeScript",
      "desc": "Re-exports shared UI components"
    },
    "web/components/animations": {
      "label": "Animations",
      "tech": "Framer Motion",
      "desc": "Shared animation wrapper and variants"
    },
    "web/components/elements": {
      "label": "UI primitives",
      "tech": "Radix UI, Headless UI",
      "desc": "Modal, popover, tooltip, toggle, checkbox"
    },
    "web/components/elements/accordion": {
      "label": "Accordion",
      "tech": "Framer Motion",
      "desc": "Animated accordion with content lists"
    },
    "web/components/elements/button": {
      "label": "Buttons",
      "tech": "class-variance-authority",
      "desc": "Styled button variants"
    },
    "web/components/elements/calendar": {
      "label": "Training calendar",
      "tech": "date-fns, Formik",
      "desc": "Month/week/day views, event creation, deletion"
    },
    "web/components/elements/forms": {
      "label": "Forms",
      "tech": "Formik, Yup",
      "desc": "Login, register, sign-up and question forms"
    },
    "web/components/elements/home-page": {
      "label": "Home scrollers",
      "tech": "Framer Motion",
      "desc": "Scroll-driven home page sections"
    },
    "web/components/elements/moving-box": {
      "label": "Moving box",
      "tech": "Framer Motion",
      "desc": "Animated decorative box"
    },
    "web/components/elements/navigation": {
      "label": "Navigation",
      "tech": "Next.js, Framer Motion",
      "desc": "Top navbar, flyout menu, footer, sidebar links"
    },
    "web/components/elements/sidebar": {
      "label": "Mobile sidebar",
      "tech": "Framer Motion",
      "desc": "Slide-out mobile navigation"
    },
    "web/components/elements/user": {
      "label": "User account UI",
      "tech": "Formik",
      "desc": "Login/register modals, profile view and edit"
    },
    "web/components/emails": {
      "label": "Email templates",
      "tech": "React (JSX)",
      "desc": "Sign-up and question email bodies"
    },
    "web/components/icons": {
      "label": "Icons",
      "tech": "lucide-react",
      "desc": "Icon set and wave background"
    },
    "web/components/supabase": {
      "label": "Auth listener",
      "tech": "Supabase JS",
      "desc": "Refreshes server data on auth change"
    },
    "web/config": {
      "label": "Site config",
      "tech": "Next.js",
      "desc": "Routes, navigation and site constants"
    },
    "web/context": {
      "label": "Supabase context",
      "tech": "Supabase auth-helpers",
      "desc": "Provides browser Supabase client and session"
    },
    "web/context/calendar-filters": {
      "label": "Calendar filters",
      "tech": "React context",
      "desc": "Calendar group filter state"
    },
    "web/context/sidebar": {
      "label": "Sidebar state",
      "tech": "React context",
      "desc": "Mobile sidebar open state"
    },
    "web/hooks": {
      "label": "UI hooks",
      "tech": "framer-motion, react-intersection-observer",
      "desc": "Scroll, viewport and mobile detection hooks"
    },
    "web/hooks/mutations": {
      "label": "Data mutations",
      "tech": "TanStack Query, Supabase JS",
      "desc": "Calendar events, presets, auth and profile writes"
    },
    "web/hooks/queries": {
      "label": "Data queries",
      "tech": "TanStack Query, Supabase JS",
      "desc": "Events, groups, presets, materials, user reads"
    },
    "web/lib": {
      "label": "Supabase clients and utils",
      "tech": "Supabase auth-helpers, tailwind-merge",
      "desc": "Browser/server Supabase clients, class utils"
    },
    "web/three": {
      "label": "3D barrel",
      "tech": "TypeScript",
      "desc": "Re-exports 3D components"
    },
    "web/three/Shader": {
      "label": "Shader",
      "tech": "React Three Fiber, GLSL",
      "desc": "Custom GLSL shader material"
    },
    "web/three/components": {
      "label": "3D canvas",
      "tech": "React Three Fiber, drei",
      "desc": "Shared canvas layout and 3D views"
    },
    "web/three/helpers": {
      "label": "3D portal",
      "tech": "tunnel-rat",
      "desc": "Tunnels 3D content into shared canvas"
    },
    "web/types": {
      "label": "Types",
      "tech": "TypeScript, Supabase codegen",
      "desc": "Generated Database types and app types"
    }
  }
}
