{
  "sources": [
    {
      "name": "web",
      "title": "Next.js web app",
      "lang": "ts",
      "root": "src",
      "depth": 2,
      "exclude": [
        "**/*.test.ts",
        "**/*.test.tsx"
      ],
      "tsconfig": "tsconfig.json",
      "depth_overrides": {
        "components/elements": 3
      }
    },
    {
      "name": "api",
      "title": "Spring Boot API",
      "lang": "java",
      "root": "api/src/main/java",
      "depth": 4,
      "exclude": []
    }
  ],
  "output": "docs/c4",
  "migrations": "api/src/main/resources/db/migration",
  "levels": {
    "level-1": [
      "package.json",
      "README.md",
      ".env.example",
      "next.config.js",
      "api/pom.xml",
      "api/src/main/resources/application.yaml"
    ],
    "level-2": [
      "package.json",
      "next.config.js",
      ".env.example",
      ".github/workflows",
      "docker-compose.prod.yml",
      "api/Dockerfile",
      "api/compose.yaml",
      "api/pom.xml",
      "api/src/main/resources",
      "src/lib",
      "src/app/layout.tsx",
      "playwright.config.ts",
      "e2e/docker-compose.yml"
    ],
    "level-3": [
      "src",
      "api/src/main/java"
    ],
    "database": [
      "api/src/main/resources/db/migration"
    ]
  },
  "human_docs": "docs/architecture",
  "components": {
    "web/(root)": {
      "label": "Module declarations",
      "tech": "TypeScript",
      "desc": "Ambient asset module type declarations"
    },
    "web/app": {
      "label": "Root layout and home",
      "tech": "Next.js App Router, React Query",
      "desc": "Root layout, providers, sitemap, robots"
    },
    "web/app-constants": {
      "label": "Form schemas",
      "tech": "Yup",
      "desc": "Form values, validation schemas, constants"
    },
    "web/app/(children)": {
      "label": "Site pages",
      "tech": "Next.js App Router, Headless UI",
      "desc": "Public pages, calendar, forms, Google login page"
    },
    "web/app/(home_components)": {
      "label": "Home page sections",
      "tech": "Next.js",
      "desc": "Landing page sections and hero images"
    },
    "web/components": {
      "label": "Component barrel",
      "tech": "TypeScript",
      "desc": "Re-exports shared UI components"
    },
    "web/components/animations": {
      "label": "Animations",
      "tech": "Framer Motion",
      "desc": "Shared animation wrapper and variants"
    },
    "web/components/elements": {
      "label": "UI primitives",
      "tech": "Radix UI, Headless UI",
      "desc": "Modal, popover, tooltip, toggle, checkbox"
    },
    "web/components/elements/accordion": {
      "label": "Accordion",
      "tech": "Framer Motion",
      "desc": "Animated accordion with content lists"
    },
    "web/components/elements/button": {
      "label": "Buttons",
      "tech": "class-variance-authority",
      "desc": "Styled button variants"
    },
    "web/components/elements/calendar": {
      "label": "Training calendar",
      "tech": "date-fns, Formik",
      "desc": "Month/week/day views, event creation, deletion"
    },
    "web/components/elements/forms": {
      "label": "Forms",
      "tech": "Formik, Yup",
      "desc": "Application and question forms posting to API"
    },
    "web/components/elements/home-page": {
      "label": "Home scrollers",
      "tech": "Framer Motion",
      "desc": "Scroll-driven home page sections"
    },
    "web/components/elements/moving-box": {
      "label": "Moving box",
      "tech": "Framer Motion",
      "desc": "Animated decorative box"
    },
    "web/components/elements/navigation": {
      "label": "Navigation",
      "tech": "Next.js, Framer Motion",
      "desc": "Top navbar, flyout menu, footer, sidebar links"
    },
    "web/components/elements/sidebar": {
      "label": "Mobile sidebar",
      "tech": "Framer Motion",
      "desc": "Slide-out mobile navigation"
    },
    "web/components/elements/user": {
      "label": "User account UI",
      "tech": "Google Identity Services, Formik",
      "desc": "Google sign-in, profile view and edit"
    },
    "web/components/icons": {
      "label": "Icons",
      "tech": "lucide-react",
      "desc": "Icon set and wave background"
    },
    "web/config": {
      "label": "Site config",
      "tech": "Next.js",
      "desc": "Routes, navigation and site constants"
    },
    "web/context": {
      "label": "Context barrel",
      "tech": "React context",
      "desc": "Re-exports sidebar and calendar filter contexts"
    },
    "web/context/calendar-filters": {
      "label": "Calendar filters",
      "tech": "React context",
      "desc": "Calendar group filter state"
    },
    "web/context/sidebar": {
      "label": "Sidebar state",
      "tech": "React context",
      "desc": "Mobile sidebar open state"
    },
    "web/hooks": {
      "label": "UI hooks",
      "tech": "framer-motion, react-intersection-observer",
      "desc": "Scroll, viewport and mobile detection hooks"
    },
    "web/hooks/mutations": {
      "label": "Data mutations",
      "tech": "TanStack Query",
      "desc": "Calendar, Preset, sign-in and profile writes via API"
    },
    "web/hooks/queries": {
      "label": "Data queries",
      "tech": "TanStack Query",
      "desc": "Events, Groups, Presets, trailers, Member reads via API"
    },
    "web/lib": {
      "label": "API client and utils",
      "tech": "fetch, tailwind-merge",
      "desc": "API calls with the stored token, class utils"
    },
    "web/three": {
      "label": "3D barrel",
      "tech": "TypeScript",
      "desc": "Re-exports 3D components"
    },
    "web/three/Shader": {
      "label": "Shader",
      "tech": "React Three Fiber, GLSL",
      "desc": "Custom GLSL shader material"
    },
    "web/three/components": {
      "label": "3D canvas",
      "tech": "React Three Fiber, drei",
      "desc": "Shared canvas layout and 3D views"
    },
    "web/three/helpers": {
      "label": "3D portal",
      "tech": "tunnel-rat",
      "desc": "Tunnels 3D content into shared canvas"
    },
    "web/types": {
      "label": "Types",
      "tech": "TypeScript",
      "desc": "Event and app types for components"
    },
    "api/(root)": {
      "label": "Application",
      "tech": "Spring Boot",
      "desc": "Entry point and dev profile data seeder"
    },
    "api/config": {
      "label": "Security and config",
      "tech": "Spring Security, OAuth2 resource server, springdoc",
      "desc": "JWT auth, Whitelist roles, CORS, clock, OpenAPI"
    },
    "api/controller": {
      "label": "REST controllers",
      "tech": "Spring Web MVC, Jakarta Validation",
      "desc": "Auth, calendar, Admin calendar, profile, club mail"
    },
    "api/dto": {
      "label": "DTOs",
      "tech": "Java records, Jakarta Validation",
      "desc": "Request and response shapes"
    },
    "api/e2e": {
      "label": "E2E test support",
      "tech": "Spring Web MVC (e2e profile)",
      "desc": "Wipes data, signs people in for Playwright"
    },
    "api/model": {
      "label": "Entities",
      "tech": "JPA, Hibernate, Lombok",
      "desc": "Members, Events, Groups, trailers, Presets"
    },
    "api/repository": {
      "label": "Repositories",
      "tech": "Spring Data JPA",
      "desc": "Entity queries, Events in a date range"
    },
    "api/service": {
      "label": "Services",
      "tech": "Spring, Spring Mail, Google API client",
      "desc": "Sign-in, calendar rules, preferences, rate-limited mail"
    },
    "api/util": {
      "label": "JWT utils",
      "tech": "Spring Security",
      "desc": "Reads the Member id from the JWT"
    }
  }
}
